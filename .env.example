# --- Authentication --------------------------------------------------------
ENERGY_ID_COFY_API_TOKEN=foo

# --- Database --------------------------------------------------------------
# Use localhost for `poe dev` (runs on host).
# Use host.docker.internal for `poe prod` (runs inside Docker).
DB_URL=postgresql+asyncpg://cofy:cofy@host.docker.internal:5432/epv

# Boundaries can live in a separate database in production.
# Falls back to DB_URL when not set.
BOUNDARY_DB_URL=postgresql+asyncpg://cofy:cofy@host.docker.internal:5432/epv

# --- Forecasts -------------------------------------------------------------
FORECASTS={"ACC_1": 42923}

# dev only, not needed for production, but useful for local development with Docker
POSTGRES_DB=epv
POSTGRES_USER=cofy
POSTGRES_PASSWORD=cofy
